{
  "schema_version": 2,
  "kind": "pages_static_site_contract",
  "project_prefix": "/prompt-compression-billing-bench/",
  "labels": {
    "source": "rights-neutral-source-allowlist",
    "visibility": "public-github-pages",
    "deployment": "main-only-actions-deploy"
  },
  "source_allowlist": [
    "docs/pages-home.md",
    "docs/pages-static.md",
    "docs/publication.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third_party/licenses/gsm8k-MIT.txt",
    "third_party/licenses/terminal-bench-2.1-Apache-2.0.txt"
  ],
  "routes": {
    "primary": {
      "docs/pages-home.md": "/",
      "docs/pages-static.md": "/site-contract/",
      "docs/publication.md": "/publication/",
      "THIRD_PARTY_NOTICES.md": "/notices/"
    }
  },
  "compatibility_anchors": [],
  "renderer_policy": {
    "source_code_execution": false,
    "active_html_execution": false,
    "raw_html": "Exact static anchors and expanded details/summary only; every other form is escaped.",
    "svg": "Copy exact bytes only after rejecting active content and external references.",
    "homepage_new_result_summary": false,
    "homepage_new_chart": false
  },
  "verification_policy": {
    "shared_parser_is_independent_oracle": false,
    "protected_content_cross_check": true,
    "generated_html_reference_check": true,
    "loopback_project_prefix_check": true
  },
  "oracle": {
    "packages": {
      "markdown-it-py": "3.0.0",
      "mdurl": "0.1.2"
    },
    "project_dialect": {
      "strong_extension": {
        "enabled": true,
        "marker": "**",
        "rule": "unescaped_boundary_pair_outside_code_or_raw_html",
        "uncertain_case": "blocking_difference",
        "excluded_shapes": [
          "whitespace-adjacent operator",
          "alphanumeric-adjacent exponent or multiplication",
          "path glob",
          "escaped marker",
          "inline or fenced code",
          "unmatched marker"
        ]
      }
    }
  },
  "browser_check": {
    "routes": [
      "/",
      "/site-contract/",
      "/publication/",
      "/notices/"
    ],
    "table_keyboard_route": "/publication/",
    "viewports": [
      {
        "name": "wide",
        "width": 1365,
        "height": 900
      },
      {
        "name": "narrow",
        "width": 390,
        "height": 844
      }
    ]
  },
  "probes": {
    "routes": [
      {
        "id": "project-root",
        "url_path": "/prompt-compression-billing-bench/",
        "expected_file": "index.html"
      },
      {
        "id": "nested-site-contract",
        "url_path": "/prompt-compression-billing-bench/site-contract/",
        "expected_file": "site-contract/index.html"
      },
      {
        "id": "directory-index",
        "url_path": "/prompt-compression-billing-bench/files/third_party/licenses/",
        "expected_file": "files/third_party/licenses/index.html"
      },
      {
        "id": "query-does-not-change-file",
        "url_path": "/prompt-compression-billing-bench/publication/?view=public",
        "expected_file": "publication/index.html"
      }
    ],
    "trailing_slash_redirect": {
      "request_path": "/prompt-compression-billing-bench/publication",
      "expected_status": 301,
      "expected_location": "/prompt-compression-billing-bench/publication/",
      "expected_file": "publication/index.html"
    },
    "no_root_fallback": [
      {
        "id": "root-assets",
        "url_path": "/assets/site.css",
        "expected_status": 404
      },
      {
        "id": "root-route",
        "url_path": "/site-contract/",
        "expected_status": 404
      }
    ],
    "encoded_hangul_fragment": {
      "source_file": "index.html",
      "href": "#%EA%B3%B5%EA%B0%9C-%EB%B2%94%EC%9C%84",
      "decoded_fragment": "공개-범위",
      "expected_occurrences": 1,
      "expected_target_file": "index.html"
    }
  },
  "preserved_red": {
    "kind": "historical_project_prefix_record_unrecoverable",
    "path": "artifacts/project-prefix-http.json",
    "known_original_bytes": 6802,
    "known_original_sha256": "c50d7f8cb418f1e8857171ec672e5c398f55b6c5c431881226ca89dfc3a34ce6",
    "body_recovered": false,
    "new_execution_is_recovery": false
  }
}
